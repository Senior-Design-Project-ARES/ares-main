<?xml version="1.6" ?>
<sdf version="1.6">
  <model name="my_robot">
    <link name="base_link">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx> <iyy>0.1</iyy> <izz>0.1</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
      </collision>
    </link>

    <link name="lidar_link">
      <pose>0 0 0.2 0 0 0</pose>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/lidar</topic>
        <update_rate>20</update_rate>
        <visualize>true</visualize>

        <lidar>
          <horizontal_samples>720</horizontal_samples>
          <horizontal_resolution>1</horizontal_resolution>
          <horizontal_min_angle>-1.5708</horizontal_min_angle>
          <horizontal_max_angle>1.5708</horizontal_max_angle>

          <vertical_samples>1</vertical_samples>
          <vertical_min_angle>0</vertical_min_angle>
          <vertical_max_angle>0</vertical_max_angle>

          <range_min>0.12</range_min>
          <range_max>8.0</range_max>
          <range_resolution>0.01</range_resolution>

          <noise_mean>0.0</noise_mean>
          <noise_stddev>0.01</noise_stddev>
        </lidar>

        <plugin
          name="gz::sim::systems::GpuLidar"
          filename="gz-sim-gpu-lidar-system">
        </plugin>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
  </model>
</sdf>
